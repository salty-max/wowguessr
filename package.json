{
  "name": "geoguessr",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit && tsc --noEmit -p web && eslint . --max-warnings 0 && prettier --check . && bun test",
    "pick": "bun scripts/pick.ts",
    "render": "bun scripts/render.ts",
    "data": "bun scripts/site.ts",
    "dev": "bun scripts/site.ts && vite",
    "build": "bun scripts/site.ts && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
